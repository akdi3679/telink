# ───────────────────────────────────────────
# Telink API — environment variables (Phase 0)
# Copy to .env before running.
# ───────────────────────────────────────────

# Application
NODE_ENV=development
APP_NAME=telink-api
APP_PORT=3000
APP_URL=http://localhost:3000
APP_CORS_ORIGINS=http://localhost:8080,http://localhost:3001

# Database (PostgreSQL)
DATABASE_URL=postgresql://telink:telink@localhost:5432/telink

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0